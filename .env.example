# 业务试点（勿提交真实地址；复制为 .env 后填写）
TESTPILOT_PILOT_BASE_URL=https://your-staging-host.example
TESTPILOT_ENV_ADMIN_PHONE=
TESTPILOT_ENV_ADMIN_PASSWORD=

# LLM（默认 DeepSeek，OpenAI 兼容接口）。复制为 .env 后替换密钥，勿提交 Git。
# 申请 Key：https://platform.deepseek.com
TESTPILOT_LLM_PROVIDER=deepseek
TESTPILOT_LLM_API_KEY=sk-REPLACE_WITH_YOUR_DEEPSEEK_KEY
TESTPILOT_LLM_BASE_URL=https://api.deepseek.com/v1
TESTPILOT_LLM_MODEL=deepseek-chat
# TESTPILOT_LLM_TEMPERATURE=0.2
# TESTPILOT_LLM_MAX_TOKENS=2048
# TESTPILOT_LLM_TIMEOUT_MS=45000

# 若改用 OpenAI：
# TESTPILOT_LLM_PROVIDER=openai
# TESTPILOT_LLM_API_KEY=sk-REPLACE_WITH_YOUR_OPENAI_KEY
# TESTPILOT_LLM_BASE_URL=https://api.openai.com/v1
# TESTPILOT_LLM_MODEL=gpt-4o-mini
