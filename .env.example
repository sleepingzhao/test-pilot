# 业务试点（勿提交真实地址；复制为 .env 后填写）
TESTPILOT_PILOT_BASE_URL=https://your-staging-host.example
TESTPILOT_ENV_ADMIN_PHONE=
TESTPILOT_ENV_ADMIN_PASSWORD=

# 试点工单 HTTP 断言：requestRef pilot-ticket-submit 匹配的 URL 片段（默认 /workorder）
# TESTPILOT_PILOT_TICKET_API_INCLUDES=/api/your-ticket-endpoint

# 试点 DB 断言（postgres-readonly）：复制 docs/assertion-db-config.example.json 为 assertion-db-config.json 后配置
# TESTPILOT_PILOT_DB_URL=postgres://readonly:****@host:5432/dbname

# 审批身份（可选；本地未配置时默认 x-testpilot-actor 或 local）
# TESTPILOT_APPROVAL_TOKEN=
# TESTPILOT_APPROVAL_ACTORS=qa-lead,qa-bot

# 回归并行度（批内并发，默认 2，上限 4）
# TESTPILOT_MAX_PARALLEL=2

# API 安全（默认只监听 127.0.0.1）
# HOST 非 127.0.0.1 时必须设置令牌；请求头 x-testpilot-token 或 Authorization: Bearer <token>
# TESTPILOT_API_TOKEN=
# 允许浏览器跨域访问 API 的源（逗号分隔；默认已含 127.0.0.1 / localhost 的 5173 与 8787）
# TESTPILOT_ALLOWED_ORIGINS=
# 允许 API 打开/录制/回归的额外目标 origin（逗号分隔；本机与试点地址默认允许）
# TESTPILOT_ALLOWED_TARGETS=

# LLM（默认 DeepSeek，OpenAI 兼容接口）。复制为 .env 后替换密钥，勿提交 Git。
# 申请 Key：https://platform.deepseek.com
TESTPILOT_LLM_PROVIDER=deepseek
TESTPILOT_LLM_API_KEY=sk-REPLACE_WITH_YOUR_DEEPSEEK_KEY
TESTPILOT_LLM_BASE_URL=https://api.deepseek.com/v1
TESTPILOT_LLM_MODEL=deepseek-chat
# TESTPILOT_LLM_TEMPERATURE=0.2
# TESTPILOT_LLM_MAX_TOKENS=2048
# TESTPILOT_LLM_TIMEOUT_MS=45000

# 若改用 OpenAI：
# TESTPILOT_LLM_PROVIDER=openai
# TESTPILOT_LLM_API_KEY=sk-REPLACE_WITH_YOUR_OPENAI_KEY
# TESTPILOT_LLM_BASE_URL=https://api.openai.com/v1
# TESTPILOT_LLM_MODEL=gpt-4o-mini
