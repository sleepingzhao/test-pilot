{
  "id": "demo-create-user-success",
  "version": 1,
  "platform": "web",
  "steps": [
    { "id": "open-users", "action": "navigate", "path": "/" },
    { "id": "add-user", "action": "click", "target": { "role": "button", "name": "添加用户" } },
    {
      "id": "fill-email",
      "action": "fill",
      "target": { "label": "邮箱" },
      "value": "new-user-{{runId}}@example.com"
    },
    { "id": "save", "action": "click", "target": { "role": "button", "name": "保存" } }
  ],
  "assertions": [
    {
      "id": "created-alert",
      "type": "ui",
      "contains": "用户已创建",
      "oracle": "human-approved"
    },
    {
      "id": "created-api",
      "type": "api",
      "requestRef": "users-create-attempt",
      "expect": { "statusCode": 201 },
      "oracle": "api-contract"
    }
  ],
  "policy": { "screenshots": "on-failure", "retry": { "attempts": 1, "on": ["transient-network"] } }
}
