{
  "id": "demo-ticket-no-attachment",
  "version": 1,
  "platform": "web",
  "steps": [
    { "id": "open-tickets", "action": "navigate", "path": "/" },
    { "id": "goto-tickets-view", "action": "click", "target": { "role": "link", "name": "我的工单" } },
    { "id": "open-form", "action": "click", "target": { "testId": "open-ticket" } },
    {
      "id": "fill-phone",
      "action": "fill",
      "target": { "label": "联系电话" },
      "value": "19900000001"
    },
    {
      "id": "fill-address",
      "action": "fill",
      "target": { "label": "详细地址" },
      "value": "TestPilot-{{runId}}"
    },
    {
      "id": "fill-detail",
      "action": "fill",
      "target": { "label": "需求说明" },
      "value": "跳过省市区街道的负向验证"
    },
    { "id": "submit", "action": "click", "target": { "testId": "submit-ticket" } },
    { "id": "wait-alert", "action": "wait", "target": { "testId": "ticket-alert" } }
  ],
  "assertions": [
    {
      "id": "ticket-region-required",
      "type": "ui",
      "target": { "testId": "ticket-alert" },
      "contains": "请选择省、市、区县和街道",
      "oracle": "human-approved"
    },
    {
      "id": "ticket-no-submit-request",
      "type": "api",
      "provider": "captured-http",
      "requestRef": "tickets-create-attempt",
      "expect": { "absent": true, "statusCode": 201 },
      "oracle": "api-contract"
    }
  ],
  "policy": { "screenshots": "on-failure" }
}
