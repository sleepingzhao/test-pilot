{
  "id": "pilot-admin-login-page",
  "version": 1,
  "platform": "web",
  "baseUrlRef": "pilot-admin",
  "steps": [{ "id": "open-login", "action": "navigate", "path": "/admin/login" }],
  "assertions": [
    {
      "id": "login-heading",
      "type": "ui",
      "contains": "登录管理控制台",
      "oracle": "requirement"
    },
    {
      "id": "password-tab",
      "type": "ui",
      "target": { "role": "tab", "name": "密码" },
      "contains": "密码",
      "oracle": "requirement"
    }
  ]
}
