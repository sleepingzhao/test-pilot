{
  "id": "pilot-admin-password-login",
  "version": 1,
  "platform": "web",
  "baseUrlRef": "pilot-admin",
  "steps": [
    { "id": "open-login", "action": "navigate", "path": "/admin/login" },
    {
      "id": "fill-phone",
      "action": "fill",
      "target": { "label": "手机号" },
      "valueRef": "env.adminPhone"
    },
    {
      "id": "fill-password",
      "action": "fill",
      "target": { "label": "密码" },
      "valueRef": "env.adminPassword"
    },
    { "id": "submit", "action": "click", "target": { "role": "button", "name": "登录" } },
    { "id": "wait-dashboard", "action": "wait" }
  ],
  "assertions": [
    {
      "id": "after-login",
      "type": "ui",
      "contains": "我的工单",
      "oracle": "human-approved"
    }
  ],
  "policy": {
    "screenshots": "on-failure",
    "retry": { "attempts": 1, "on": ["ENVIRONMENT"] }
  }
}
