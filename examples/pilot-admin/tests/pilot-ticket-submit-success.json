{
  "id": "pilot-ticket-submit-success",
  "version": 1,
  "platform": "web",
  "baseUrlRef": "pilot-admin",
  "steps": [
    { "id": "open-login", "action": "navigate", "path": "/admin/login" },
    {
      "id": "pick-password-tab",
      "action": "click",
      "target": { "role": "tab", "name": "密码" }
    },
    {
      "id": "fill-phone",
      "action": "fill",
      "target": { "label": "手机号" },
      "valueRef": "env.ticketPhone"
    },
    {
      "id": "fill-password",
      "action": "fill",
      "target": { "placeholder": "请输入密码" },
      "valueRef": "env.adminPassword"
    },
    { "id": "submit-login", "action": "click", "target": { "role": "button", "name": "登录" } },
    { "id": "wait-login-done", "action": "wait", "target": { "name": "我的工单" } },
    { "id": "goto-customer", "action": "navigate", "path": "/customer" },
    { "id": "open-ticket", "action": "click", "target": { "role": "button", "name": "提交工单" } },
    {
      "id": "fill-contact-phone",
      "action": "fill",
      "target": { "label": "联系电话" },
      "valueRef": "env.ticketPhone"
    },
    {
      "id": "fill-address",
      "action": "fill",
      "target": { "label": "详细地址" },
      "value": "TestPilot-{{runId}}"
    },
    {
      "id": "fill-detail",
      "action": "fill",
      "target": { "label": "需求说明" },
      "value": "试点自动回归 {{runId}}"
    },
    { "id": "pick-province", "action": "click", "target": { "label": "省" } },
    { "id": "pick-province-option", "action": "click", "target": { "role": "option", "name": "广东省" } },
    { "id": "pick-city", "action": "click", "target": { "label": "市" } },
    { "id": "pick-city-option", "action": "click", "target": { "role": "option", "name": "深圳市" } },
    { "id": "pick-district", "action": "click", "target": { "label": "区县" } },
    { "id": "pick-district-option", "action": "click", "target": { "role": "option", "name": "南山区" } },
    { "id": "pick-street", "action": "click", "target": { "label": "街道" } },
    { "id": "pick-street-option", "action": "click", "target": { "role": "option", "name": "粤海街道" } },
    { "id": "confirm-submit", "action": "click", "target": { "role": "button", "name": "确认提交" } }
  ],
  "assertions": [
    {
      "id": "ticket-submit-success-ui",
      "type": "ui",
      "target": { "role": "alert" },
      "contains": "工单已提交",
      "oracle": "human-approved"
    },
    {
      "id": "ticket-submit-success-api",
      "type": "api",
      "provider": "captured-http",
      "requestRef": "pilot-ticket-submit",
      "expect": {
        "statusCode": 200,
        "requestBodyContains": "TestPilot-"
      },
      "oracle": "api-contract"
    }
  ],
  "policy": {
    "screenshots": "on-failure",
    "retry": { "attempts": 1, "on": ["ENVIRONMENT"] }
  }
}
