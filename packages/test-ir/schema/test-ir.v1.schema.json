{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://testpilot.dev/schemas/test-ir/v1.json",
  "title": "TestPilot Test IR v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "platform", "steps", "assertions"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "platform": {
      "type": "string",
      "enum": ["web"]
    },
    "baseUrl": {
      "type": "string",
      "minLength": 1,
      "pattern": "^https?://[^\\s]+$"
    },
    "baseUrlRef": {
      "type": "string",
      "minLength": 1
    },
    "fixture": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    },
    "teardownSteps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    },
    "assertions": {
      "type": "array",
      "items": { "$ref": "#/$defs/assertion" }
    },
    "policy": { "$ref": "#/$defs/policy" }
  },
  "$defs": {
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "testId": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "label": { "type": "string", "minLength": 1 },
        "placeholder": { "type": "string", "minLength": 1 },
        "css": { "type": "string", "minLength": 1 }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "action": {
          "type": "string",
          "enum": ["navigate", "click", "fill", "press", "wait", "select", "selectCascader", "request", "upload"]
        },
        "path": { "type": "string" },
        "target": { "$ref": "#/$defs/locator" },
        "value": { "type": "string" },
        "valueRef": { "type": "string", "minLength": 1 },
        "key": { "type": "string", "minLength": 1 },
        "cascaderPath": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "method": {
          "type": "string",
          "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD"]
        },
        "headers": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "body": {
          "oneOf": [
            { "type": "string" },
            { "type": "object" }
          ]
        },
        "form": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "saveAs": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "saveFields": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "saveFromRef": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": { "properties": { "action": { "const": "navigate" } } },
          "then": { "required": ["path"] }
        },
        {
          "if": { "properties": { "action": { "const": "click" } } },
          "then": { "required": ["target"] }
        },
        {
          "if": { "properties": { "action": { "const": "fill" } } },
          "then": {
            "anyOf": [
              { "required": ["target", "value"] },
              { "required": ["target", "valueRef"] }
            ]
          }
        },
        {
          "if": { "properties": { "action": { "const": "select" } } },
          "then": {
            "anyOf": [
              { "required": ["target", "value"] },
              { "required": ["target", "valueRef"] }
            ]
          }
        },
        {
          "if": { "properties": { "action": { "const": "selectCascader" } } },
          "then": {
            "required": ["target", "cascaderPath"]
          }
        },
        {
          "if": { "properties": { "action": { "const": "request" } } },
          "then": { "required": ["method", "path"] }
        },
        {
          "if": { "properties": { "action": { "const": "upload" } } },
          "then": { "required": ["target", "valueRef"] }
        }
      ]
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "oracle"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["ui", "api", "db", "event", "agent", "custom"]
        },
        "provider": { "type": "string", "minLength": 1 },
        "configRef": { "type": "string", "minLength": 1 },
        "target": { "$ref": "#/$defs/locator" },
        "contains": { "type": "string" },
        "requestRef": { "type": "string", "minLength": 1 },
        "stepRef": { "type": "string", "minLength": 1 },
        "expect": { "type": "object" },
        "oracle": {
          "type": "string",
          "enum": ["human-approved", "requirement", "api-contract"]
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "screenshots": {
          "type": "string",
          "enum": ["never", "on-failure", "always"]
        },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "attempts": { "type": "integer", "minimum": 0, "maximum": 5 },
            "on": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "dataIsolation": {
          "type": "string",
          "enum": ["shared", "per-run"]
        },
        "cleanup": {
          "type": "string",
          "enum": ["none", "on-success", "always"]
        }
      }
    }
  }
}
