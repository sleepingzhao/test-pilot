{
  "name": "@testpilot/test-management",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/batch-metrics.test.ts src/security.test.ts src/approval.test.ts src/llm-config.test.ts src/run-env.test.ts src/run-target.test.ts src/seed.test.ts",
    "lint": "echo 'no lint configured'"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/sensible": "^6.0.1",
    "@fastify/static": "^8.0.2",
    "@testpilot/context-web": "workspace:*",
    "@testpilot/evidence": "workspace:*",
    "@testpilot/fixtures": "workspace:*",
    "@testpilot/planner": "workspace:*",
    "@testpilot/recorder-web": "workspace:*",
    "@testpilot/runner-web": "workspace:*",
    "@testpilot/test-ir": "workspace:*",
    "dotenv": "^16.4.7",
    "fastify": "^5.1.0",
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
